# ===========================================
# IntelliDesk 环境变量配置模板
# 复制为 .env 后填入真实值
# ===========================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intellidesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Elasticsearch (Phase 3+) ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change_me

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=intellidesk-documents
MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=30
MINIO_WRITE_TIMEOUT_SECONDS=30

# --- Document Ingestion ---
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=25MB
MAX_FILE_SIZE_BYTES=20971520
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARACTERS=5000000
PROCESSING_LEASE_MINUTES=10
DISPATCH_STALE_TIMEOUT_SECONDS=60
DISPATCHER_INTERVAL_SECONDS=10
RETRY_DELAY_SECONDS=30
MAX_ATTEMPTS=3
UPLOAD_CLEANUP_GRACE_SECONDS=120
RECOVERY_SCHEDULER_ENABLED=true

# --- JWT ---
JWT_SECRET=change_me_to_a_secure_random_string
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- LLM API (Example only, replace with your provider) ---
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-llm-provider.example.com
LLM_MODEL=your-llm-model

# --- Embedding API (Example only, replace with your provider) ---
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://your-embedding-provider.example.com
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSION=1536

# --- Chat API (Phase 4) ---
# ChatLlmProperties binds prefix `intellidesk.chat` -> OS env INTELLIDESK_CHAT_*.
# application.yml also exposes CHAT_* as placeholders, but an exported INTELLIDESK_CHAT_*
# OS env var wins (higher property-source precedence) and overrides the CHAT_* placeholder.
INTELLIDESK_CHAT_BASE_URL=https://api.openai.com
INTELLIDESK_CHAT_API_KEY=sk-your-chat-api-key
INTELLIDESK_CHAT_MODEL=gpt-4o-mini
# Local fallback when no INTELLIDESK_CHAT_* env is exported.
CHAT_BASE_URL=https://api.openai.com
CHAT_API_KEY=sk-your-chat-api-key
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=2048
CHAT_TIMEOUT_SECONDS=60

# --- Query Rewrite (Phase 4) ---
REWRITE_ENABLED=true
REWRITE_HISTORY_MESSAGES=4
REWRITE_MAX_LENGTH=500

# --- Rerank API ---
RERANK_API_KEY=your-rerank-api-key
RERANK_BASE_URL=https://your-rerank-provider.example.com
RERANK_MODEL=your-rerank-model

# --- API Key ---
API_KEY_PREFIX_LENGTH=8
API_KEY_SECRET_BYTES=32
API_KEY_MAX_PREFIX_RETRIES=5

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Observability / Grafana (Phase 7 Wave 5) ---
# Grafana admin password; compose only injects it via env (never hardcoded).
GRAFANA_PASSWORD=change_me_grafana